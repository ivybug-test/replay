[Unit]
Description=Replay trajectory workbench on port 18768 (standalone backend)
After=network-online.target replay-backend-18769.service
Wants=network-online.target replay-backend-18769.service

[Service]
Type=simple
# %h is the service user's home, so the unit works for any checkout named
# `replay` in that home instead of hardcoding one user's path.
WorkingDirectory=%h/replay
ExecStart=/usr/bin/node %h/replay/server.mjs
Environment=NODE_ENV=production
Environment=REPLAY_HOST=0.0.0.0
Environment=REPLAY_PORT=18768
Environment=REPLAY_BACKEND_URL=http://127.0.0.1:18769
Environment=REPLAY_STATIC_ROOT=dist
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
MemoryHigh=384M
MemoryMax=512M

[Install]
WantedBy=default.target
